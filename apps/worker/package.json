{
  "name": "@repo/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/reader": "workspace:*",
    "@repo/sources": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "pg-boss": "^12.34.0",
    "pino": "^10.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
