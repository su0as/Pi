NODE_ENV=development
DATABASE_URL=postgres://pi:pi_dev_password@localhost:5432/pi_dev

# M4: ingestion
ARXIV_CONTACT_EMAIL=arxiv-contact@pi.example
HARVEST_CATEGORIES=cs.AI,cs.LG,cs.CV,cs.CL,cs.RO,cs.HC,eess.SY,eess.SP,eess.IV,stat.ML,q-bio.GN,q-bio.NC,q-bio.QM
HARVEST_CRON=0 3 * * *
HARVEST_CRON_TZ=UTC
HARVEST_BULK_WINDOW_MONTHS=6

# M5: reader pipeline — SeaweedFS locally (see docker-compose.yml / ADR-0004), R2 in production.
OBJECT_STORAGE_BUCKET=pi-dev
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT=http://localhost:8333
OBJECT_STORAGE_ACCESS_KEY_ID=pi_dev_access_key
OBJECT_STORAGE_SECRET_ACCESS_KEY=pi_dev_secret_key_change_me
READER_PIPELINE_VERSION=1
