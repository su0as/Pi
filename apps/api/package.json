{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -- vitest run",
    "openapi:write": "tsx src/write-openapi.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "@repo/config": "workspace:*",
    "@repo/db": "workspace:*",
    "@scalar/hono-api-reference": "^0.12.6",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "pino": "^10.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "dotenv-cli": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
