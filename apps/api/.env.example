NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://pi:pi_dev_password@localhost:5432/pi_dev
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
IDEMPOTENCY_KEY_TTL_MS=86400000

# M3: auth — generate a real value for anything beyond local dev, e.g. `openssl rand -hex 32`.
# This one is a placeholder, not a secret worth protecting.
BETTER_AUTH_SECRET=dev-only-secret-change-me-00000000000000000000000000000000
BETTER_AUTH_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# Leave both unset locally — email OTP sign-in works without them. Real values are a deploy-time
# secret (Google/Apple developer console), never committed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# M3: email — Mailpit locally (see docker-compose.yml), a real RESEND_API_KEY in every other
# environment (leaving it unset here is what selects the SMTP/Mailpit path).
EMAIL_FROM=noreply@pi.example
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=

# M4: ingestion — arXiv's stated politeness contact, reused as OpenAlex/Crossref's `mailto` too.
ARXIV_CONTACT_EMAIL=arxiv-contact@pi.example
WORK_RESOLVE_TIMEOUT_MS=10000
